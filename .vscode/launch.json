{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CMake: Debug Demo (GCC)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/demo",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
